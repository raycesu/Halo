---
title: Custom Constellation use case
---
classDiagram
direction LR

%% ---------- View ----------
class SkyView {
  -ConstellationController constellationController
  -ConstellationViewModel constellationViewModel
  -List~StarDisplayData~ constellationSelection
  +configureCustomConstellations(ConstellationController, ConstellationViewModel)
}

%% ---------- Interface Adapters ----------
class ConstellationController {
  -ConstellationInputBoundary inputBoundary
  +createConstellation(String name, List~StarDisplayData~ selectedStars)
}

class ConstellationPresenter {
  -ConstellationViewModel viewModel
  +prepareSuccessView(ConstellationOutputData)
  +prepareFailureView(String)
  -toDisplayData(CustomConstellation) ConstellationDisplayData
}

class ConstellationViewModel {
  -List~ConstellationDisplayData~ constellations
  -String errorMessage
  -String successMessage
  +addConstellation(ConstellationDisplayData)
  +setErrorMessage(String)
  +setSuccessMessage(String)
  +addPropertyChangeListener(PropertyChangeListener)
}

class StarDisplayData {
  -String catalogueId
  -String displayName
  -double rightAscension
  -double declination
  -double apparentMagnitude
  -String constellationRegion
  -String spectralType
  -String description
  -String type
  -double altitude
  -double azimuth
  -boolean aboveHorizon
}

class ConstellationDisplayData {
  -String name
  -List~Line~ lines
  +getName() String
  +getLines() List~Line~
}

class ConstellationDisplayData_Line {
  <<inner class>>
  -double startAltitude
  -double startAzimuth
  -boolean startAboveHorizon
  -double endAltitude
  -double endAzimuth
  -boolean endAboveHorizon
}

%% ---------- Use Case layer ----------
class ConstellationInputBoundary {
  <<interface>>
  +execute(ConstellationInputData)
}

class ConstellationOutputBoundary {
  <<interface>>
  +prepareSuccessView(ConstellationOutputData)
  +prepareFailureView(String)
}

class ConstellationInteractor {
  -ConstellationDataAccessInterface dataAccess
  -ConstellationOutputBoundary outputBoundary
  +execute(ConstellationInputData)
  -containsDuplicateStars(List~Star~) boolean
  -createLines(List~Star~) List~ConstellationLine~
}

class ConstellationInputData {
  -String name
  -List~Star~ selectedStars
}

class ConstellationOutputData {
  -CustomConstellation constellation
  +getConstellation() CustomConstellation
}

class ConstellationDataAccessInterface {
  <<interface>>
  +existsByName(String) boolean
  +save(CustomConstellation)
  +findAll() List~CustomConstellation~
}

%% ---------- Data Access ----------
class InMemoryConstellationDataAccessObject

%% ---------- Entities ----------
class Constellation {
  -String name
  -List~ConstellationLine~ lines
  +getName() String
  +getLines() List~ConstellationLine~
}

class CustomConstellation

class ConstellationLine {
  -Star startStar
  -Star endStar
  +getStartStar() Star
  +getEndStar() Star
}

class Star {
  -String catalogueId
  -String displayName
  -double rightAscension
  -double declination
  -double apparentMagnitude
  -double altitude
  -double azimuth
}

%% ---------- Relationships ----------
SkyView --> ConstellationController : calls
SkyView ..> ConstellationViewModel : listens

ConstellationController --> ConstellationInputBoundary
ConstellationController ..> ConstellationInputData : creates
ConstellationController ..> Star : reconstructs from StarDisplayData

ConstellationInteractor ..|> ConstellationInputBoundary
ConstellationInteractor --> ConstellationDataAccessInterface
ConstellationInteractor --> ConstellationOutputBoundary
ConstellationInteractor ..> ConstellationOutputData : creates
ConstellationInteractor ..> CustomConstellation : creates
ConstellationInteractor ..> ConstellationLine : creates

ConstellationPresenter ..|> ConstellationOutputBoundary
ConstellationPresenter --> ConstellationViewModel
ConstellationPresenter ..> ConstellationDisplayData : creates

InMemoryConstellationDataAccessObject ..|> ConstellationDataAccessInterface

CustomConstellation --|> Constellation
Constellation o-- ConstellationLine
ConstellationLine o-- Star
ConstellationInputData o-- Star
ConstellationOutputData o-- CustomConstellation
ConstellationViewModel o-- ConstellationDisplayData
ConstellationDisplayData *-- ConstellationDisplayData_Line : nested
